# Spotify Developer application (server-only)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Supabase project connection (the anon key is designed for browser use; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vision model, used only for scanned or photographed chord charts.
# Any OpenAI-compatible endpoint works — Luna, OpenAI, or a local gateway.
VISION_API_KEY=
VISION_API_URL=https://api.openai.com/v1/chat/completions
VISION_MODEL=gpt-4o-mini

# Canonical deployed URL for social metadata
NEXT_PUBLIC_SITE_URL=https://chars-guitar.charlie93110.chatgpt.site
